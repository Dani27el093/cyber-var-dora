# Entorno virtual
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Datos (nunca versionar datasets ni binarios)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/reference/*
!data/reference/.gitkeep
!data/reference/README.md
!data/reference/fx_rates.csv
!data/reference/hicp_ea20.csv

# Salidas generadas
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/logs/*
!outputs/logs/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Editores y sistema
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secretos y temporales
.env
.env.*
*.log
*.tmp
*.part

# Comprimidos y parquet (se regeneran con scripts)
*.zip
*.parquet
*.csv.gz
